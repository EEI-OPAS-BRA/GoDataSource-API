{
  "name": "syncLog",
  "base": "databaseActionLog",
  "idInjection": true,
  "options": {
    "validateUpsert": true
  },
  "hidden": [
    "type"
  ],
  "scope": {
    "where": {
      "type": "sync"
    }
  },
  "properties": {
    "type": {
      "type": "string",
      "required": true,
      "default": "sync",
      "readOnly": true
    },
    "syncClientId": {
      "type": "string",
      "description": "Client ID which is synced with the server. Present in the entries for Server instances"
    },
    "syncStep": {
      "type": "string",
      "description": "Step of a sync with an upstream server: CONNECT, CREDENTIALS, EXPORT, SEND, IMPORT or NO_DATA (nothing to send). When the sync fails, it is the step that failed"
    },
    "syncStepErrorCode": {
      "type": "string",
      "description": "Why the server couldn't be reached or didn't accept the credentials (e.g. CONNECTION_REFUSED, INVALID_CREDENTIALS)"
    },
    "syncStepErrorDetail": {
      "type": "string",
      "description": "Technical code of the connection error"
    }
  },
  "validations": [],
  "relations": {},
  "acls": [
    {
      "principalType": "ROLE",
      "principalId": "$everyone",
      "permission": "DENY"
    },
    {
      "principalType": "ROLE",
      "principalId": "sync_log_list",
      "permission": "ALLOW",
      "property": "find"
    },
    {
      "principalType": "ROLE",
      "principalId": "sync_log_list",
      "permission": "ALLOW",
      "property": "count"
    },
    {
      "principalType": "ROLE",
      "principalId": "sync_log_view",
      "permission": "ALLOW",
      "property": "findById"
    },
    {
      "principalType": "ROLE",
      "principalId": "$client_application",
      "permissions": "ALLOW",
      "property": "findById"
    },
    {
      "principalType": "ROLE",
      "principalId": "sync_log_delete",
      "permission": "ALLOW",
      "property": "deleteById"
    },
    {
      "principalType": "ROLE",
      "principalId": "sync_log_bulk_delete",
      "permission": "ALLOW",
      "property": "bulkDelete"
    }
  ],
  "methods": {
    "bulkDelete": {
      "accepts": [
        {
          "arg": "where",
          "type": "object",
          "description": "Criteria to match model instances"
        },
        {
          "arg": "options",
          "type": "object",
          "http": "optionsFromRequest"
        }
      ],
      "returns": [
        {
          "arg": "count",
          "type": "number",
          "required": true,
          "description": "Number of deleted sync log entries"
        }
      ],
      "description": "Delete sync log entries that match the criteria.",
      "http": {
        "verb": "del",
        "path": "/"
      }
    }
  }
}
