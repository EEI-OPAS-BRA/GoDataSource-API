{
  "name": "teamNotificationOccurrence",
  "base": "extendedPersistedModel",
  "idInjection": true,
  "options": {
    "validateUpsert": true
  },
  "properties": {
    "teamNotificationId": {
      "type": "string",
      "required": true
    },
    "outbreakId": {
      "type": "string"
    },
    "teamIds": {
      "type": [
        "string"
      ],
      "description": "Teams that receive this occurrence ( resolved when the occurrence was triggered )"
    },
    "teamId": {
      "type": "string",
      "description": "Deprecated - single team used by legacy occurrences, replaced by teamIds"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "string",
      "required": true
    },
    "severity": {
      "type": "string",
      "required": true
    },
    "triggeredAt": {
      "type": "date",
      "required": true
    },
    "readBy": {
      "type": [
        "string"
      ],
      "default": []
    },
    "dismissedBy": {
      "type": [
        "string"
      ],
      "default": [],
      "description": "Users that removed this occurrence from their notifications"
    }
  },
  "indexes": {
    "teamId_index": {
      "teamId": 1
    },
    "teamIds_index": {
      "teamIds": 1
    },
    "triggeredAt_index": {
      "triggeredAt": 1
    }
  },
  "validations": [],
  "relations": {
    "teamNotification": {
      "type": "belongsTo",
      "model": "teamNotification",
      "foreignKey": "teamNotificationId"
    }
  },
  "acls": [
    {
      "principalType": "ROLE",
      "principalId": "$everyone",
      "permission": "DENY"
    }
  ],
  "methods": {}
}
