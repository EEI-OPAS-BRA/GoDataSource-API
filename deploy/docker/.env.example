# Image tag to run, without the leading v (for example 2026.10.0)
GODATA_VERSION=
# Use 127.0.0.1 when a reverse proxy on this host serves Go.Data
GODATA_BIND=0.0.0.0
GODATA_PORT=3000
GODATA_DB=go-data
# Put a password in single quotes when it contains $, # or spaces
MONGO_ROOT_PASSWORD=
GODATA_MONGO_PASSWORD=
