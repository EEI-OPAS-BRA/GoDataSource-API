# Settings that describe the deploy host.
#
# This repository is public, so nothing here may be filled in and committed.
# Copy it to the deploy user's ~/.config/godata/deploy.env on the runner, fill
# it in there, and keep that file readable only by the deploy user:
#
#   install -Dm600 ops/deploy.env.example ~/.config/godata/deploy.env
#
# Override the location with GODATA_DEPLOY_ENV when it lives elsewhere.

# Parent directory holding one checkout tree per instance. Each instance is
# expected at $GODATA_ROOT/<instance>/GoDataSource-API and
# $GODATA_ROOT/<instance>/GoDataSource-FrontEnd.
GODATA_ROOT=

# Where the pre-migration database dumps are written. The ten most recent are
# kept per database.
GODATA_BACKUP_ROOT=

# Process manager service name for each instance, uppercased in the variable
# name: GODATA_SERVICE_<INSTANCE>.
GODATA_SERVICE_TESTE=
GODATA_SERVICE_OPAS=
